# Settings of `npm run dev:mock`: the app runs against the stand-in backend in mock/ and needs no LocalStack,
# no Cognito and no real accounts. Public local values only.
VITE_COGNITO_ENDPOINT=http://127.0.0.1:5173/cognito/
VITE_COGNITO_CLIENT_ID=mock
VITE_MEDIA_BASE_URL=http://127.0.0.1:5173/media
