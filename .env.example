# Copy to .env.local; `make client-env` in the backend repo prints these values.
# The ids change every time LocalStack is recreated. Names and local examples only.

# Dev and preview servers proxy /v1 to the gateway (same origin as the page, so no CORS).
VITE_GATEWAY_PROXY_TARGET=http://localhost:4566/restapis/<api-id>/v1/_user_request_
# Cognito endpoint (LocalStack) and the app client id of the `growpath` user pool.
VITE_COGNITO_ENDPOINT=http://localhost:4566/
VITE_COGNITO_CLIENT_ID=<client-id>
# Item pictures live at <base>/<item slug>.webp; a missing file shows the placeholder. Not part of the API.
VITE_MEDIA_BASE_URL=http://localhost:4566/growpath-media

# End-to-end tests only (npm run test:e2e): two accounts that exist on LocalStack, one regular and one in the experts group.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_EXPERT_EMAIL=
E2E_EXPERT_PASSWORD=
# Optional: without an administrator the admin checks are skipped.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
