# Copy to .env.local and fill in. Values below are names and local examples only.
# Gateway base URL; <api-id> changes after every LocalStack restart.
VITE_API_BASE_URL=http://localhost:4566/restapis/<api-id>/v1/_user_request_
# Cognito endpoint (LocalStack) and the app client id of the `growpath` user pool.
VITE_COGNITO_ENDPOINT=http://localhost:4566
VITE_COGNITO_CLIENT_ID=<client-id>
